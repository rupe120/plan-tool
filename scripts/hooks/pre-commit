#!/usr/bin/env python3
"""Tracked pre-commit hook: block a commit that stages an apparent secret.

Scans only newly staged lines (the diff, not whole files) plus staged file
names, so it doesn't re-flag a secret-shaped string that was already sitting
in the repo before this hook existed — only content this commit introduces.

Installed by `scripts/hooks/install.sh` (sets core.hooksPath). Verify-only —
it never edits or removes anything. Bypass a single commit with
`git commit --no-verify` for a confirmed false positive, or silence one line
permanently with a trailing `# pragma: allowlist secret` comment.
"""
from __future__ import annotations

import re
import subprocess
import sys

ALLOWLIST_MARKER = "pragma: allowlist secret"

# High-confidence provider token formats, checked first, then one generic
# heuristic for a `key/secret/token/password = "<literal>"` assignment.
SECRET_PATTERNS: list[tuple[str, re.Pattern[str], bool]] = [
    ("AWS access key ID", re.compile(r"\bAKIA[0-9A-Z]{16}\b"), False),
    (
        "AWS secret access key",
        re.compile(r"(?i)aws_secret_access_key\s*[:=]\s*['\"][A-Za-z0-9/+=]{40}['\"]"),
        False,
    ),
    (
        "private key block",
        re.compile(r"-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY-----"),
        False,
    ),
    ("GitHub token", re.compile(r"\bgh[pousr]_[A-Za-z0-9]{36,}\b"), False),
    ("GitLab token", re.compile(r"\bglpat-[A-Za-z0-9_-]{20,}\b"), False),
    ("Slack token", re.compile(r"\bxox[baprs]-[0-9A-Za-z-]{10,}\b"), False),
    (
        "Slack webhook URL",
        re.compile(r"https://hooks\.slack\.com/services/[A-Za-z0-9/+]{20,}"),
        False,
    ),
    ("Google API key", re.compile(r"\bAIza[0-9A-Za-z\-_]{35}\b"), False),
    ("Anthropic API key", re.compile(r"\bsk-ant-[A-Za-z0-9\-_]{20,}\b"), False),
    ("OpenAI project API key", re.compile(r"\bsk-proj-[A-Za-z0-9_\-]{20,}\b"), False),
    (
        "OpenAI API key",
        re.compile(r"\bsk-[A-Za-z0-9]{20,}T3BlbkFJ[A-Za-z0-9]{20,}\b"),
        False,
    ),
    ("Stripe live key", re.compile(r"\bsk_live_[0-9a-zA-Z]{16,}\b"), False),
    (
        "hardcoded secret/token/password literal",
        re.compile(
            r"(?i)\b(secret|api[_-]?key|access[_-]?key|auth[_-]?token|token|passwd|password)"
            r"\b\s*[:=]\s*['\"]([A-Za-z0-9/+_\-]{16,})['\"]"
        ),
        True,
    ),
]

# Case-insensitive substrings that mean the generic-pattern match is an
# obvious placeholder or a reference (not a literal secret).
PLACEHOLDER_MARKERS = (
    "changeme", "change_me", "xxxx", "example", "placeholder", "dummy",
    "fake", "your-", "your_", "insert", "replace", "<", ">", "${", "os.environ",
    "getenv",
)

# Files that should never be staged, regardless of content.
SENSITIVE_FILENAME_PATTERNS = [
    re.compile(r"(^|/)\.env(\.[^./]+)?$"),
    re.compile(r"(^|/)id_(rsa|dsa|ecdsa|ed25519)$"),
    re.compile(r"\.(pem|p12|pfx|keystore|jks)$"),
    re.compile(r"(^|/)credentials\.json$"),
]
SENSITIVE_FILENAME_EXCEPTIONS = re.compile(
    r"\.(example|sample|template|dist|pub)$"
)

ADDED_LINE_RE = re.compile(r"^\+(?!\+\+)(.*)$")
HUNK_HEADER_RE = re.compile(r"^@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@")
FILE_HEADER_RE = re.compile(r"^\+\+\+ b/(.*)$")


def _run(*args: str) -> str:
    return subprocess.run(args, capture_output=True, text=True, check=True).stdout


def _staged_file_names() -> list[str]:
    out = _run("git", "diff", "--cached", "--name-only", "--diff-filter=ACMR")
    return [line for line in out.splitlines() if line]


def _redact(value: str) -> str:
    if len(value) <= 8:
        return "*" * len(value)
    return f"{value[:4]}...{value[-4:]}"


def check_filenames(paths: list[str]) -> list[str]:
    findings = []
    for path in paths:
        if SENSITIVE_FILENAME_EXCEPTIONS.search(path):
            continue
        for pattern in SENSITIVE_FILENAME_PATTERNS:
            if pattern.search(path):
                findings.append(
                    f"{path}: filename looks like a credential file "
                    f"(matches `{pattern.pattern}`)"
                )
                break
    return findings


def check_diff() -> list[str]:
    diff = _run(
        "git", "diff", "--cached", "-U0", "--no-color", "--diff-filter=ACMR"
    )
    findings = []
    current_file: str | None = None
    current_line = 0
    for raw_line in diff.splitlines():
        file_match = FILE_HEADER_RE.match(raw_line)
        if file_match:
            current_file = file_match.group(1)
            continue
        hunk_match = HUNK_HEADER_RE.match(raw_line)
        if hunk_match:
            current_line = int(hunk_match.group(1))
            continue
        added_match = ADDED_LINE_RE.match(raw_line)
        if not added_match or current_file is None:
            continue
        content = added_match.group(1)
        line_no = current_line
        current_line += 1
        if ALLOWLIST_MARKER in content:
            continue
        for name, pattern, is_generic in SECRET_PATTERNS:
            match = pattern.search(content)
            if not match:
                continue
            literal = match.group(2) if is_generic else match.group(0)
            if is_generic and any(
                marker in literal.lower() for marker in PLACEHOLDER_MARKERS
            ):
                continue
            findings.append(
                f"{current_file}:{line_no}: possible {name} ({_redact(literal)})"
            )
            break
    return findings


def main() -> int:
    try:
        paths = _staged_file_names()
        findings = check_filenames(paths)
        findings += check_diff()
    except subprocess.CalledProcessError as exc:
        print(f"pre-commit: could not inspect staged changes: {exc.stderr}", file=sys.stderr)
        return 1

    if not findings:
        return 0

    print("pre-commit: possible secret(s) staged for commit — blocked.", file=sys.stderr)
    print(file=sys.stderr)
    for finding in findings:
        print(f"  {finding}", file=sys.stderr)
    print(file=sys.stderr)
    print("          Real credential: remove it, and rotate it if it was ever", file=sys.stderr)
    print("          pushed — use an env var or secrets manager instead.", file=sys.stderr)
    print("          False positive: add a trailing `# pragma: allowlist secret`", file=sys.stderr)
    print("          comment on that line, or bypass once with:", file=sys.stderr)
    print("          git commit --no-verify", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
